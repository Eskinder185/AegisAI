# Copy to .env (never commit .env). All values below are development defaults.

# Database. SQLite by default; use a PostgreSQL URL for Compose/production-like use.
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis

# Development-only seed password for admin@/analyst@/viewer@aegis.local (created ONLY by `python -m aegis.cli seed`).
AEGIS_DEV_SEED_PASSWORD=aegis-demo-2026!

# HMAC key for run manifests. Leave empty to auto-generate and store one in the local database.
AEGIS_MANIFEST_KEY=

# Set to production to make the seed command refuse to create development users.
AEGIS_ENVIRONMENT=development

# Set true when serving over HTTPS.
AEGIS_COOKIE_SECURE=false

# Optional AI provider. Default is none: every feature works without a model.
AEGIS_MODEL_PROVIDER=none
# AEGIS_MODEL_PROVIDER=ollama
# AEGIS_OLLAMA_URL=http://127.0.0.1:11434
# AEGIS_OLLAMA_MODEL=llama3.2

# Cosmetic pacing so the UI can show each real step (milliseconds). Set 0 for full speed.
AEGIS_STEP_DELAY_MS=350
